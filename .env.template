# Copy to .env and fill in real values

# Home Assistant base URL
HA_BASE_URL=https://home.int.bornholm.se

# Long-lived access token (Profile > Security > Long-Lived Access Tokens)
HA_API_TOKEN=

# Path to the CA certificate used to verify the HA server (put it in certs/)
HA_CA_CERT_PATH=./certs/home-ca.crt

# Port for this API to listen on
PORT=3000
